{
  "name": "asia-motor-redesign",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "render": "node tools/render.mjs",
    "test:pricing": "tsx --test src/pricing/engine.test.ts",
    "build:pages": "BASE_PATH=/AsiaMotor/ npm run build && BASE_PATH=/AsiaMotor/ tsx scripts/prerender.ts",
    "prerender": "tsx scripts/prerender.ts",
    "deploy:docs": "npm run build:pages && rm -rf docs && cp -r dist docs && touch docs/.nojekyll",
    "model:inspect": "tsx scripts/inspect-model.ts",
    "model:optimize": "bash scripts/optimize-model.sh",
    "catalog:import": "tsx scripts/import-catalog.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "xlsx": "^0.18.5"
  }
}
