# Form mail settings. Copy to .env for local runs (`npm run dev`); in production set the same
# names as environment variables / secrets of the hosting (Cloudflare Pages → Settings →
# Variables and Secrets). Never commit real values: .env is git-ignored.

# Mail API: "brevo" (https://www.brevo.com, free plan: 300 e-mails a day) or "resend" (https://resend.com)
MAIL_PROVIDER=brevo
# API key of that service (Brevo: SMTP & API → API keys; Resend: API Keys)
MAIL_API_KEY=
# Sender. Must be verified in the mail service (Brevo: Senders → add and confirm the address;
# Resend: verify the domain). Example: Asia Motor <info@asiamotor.com.ua>
MAIL_FROM=
# Where orders and requests are delivered, comma separated. Example: info@asiamotor.com.ua
MAIL_TO=
# Only when the site and the API live on different addresses (e.g. the site on GitHub Pages and
# the API on Cloudflare): the site's origin, comma separated. Example: https://k1s1l.github.io
ALLOWED_ORIGINS=

# Build-time setting of the site (public, not a secret): where the site sends forms.
# Leave empty when the site and /api are on the same host (Cloudflare Pages).
# Example for the GitHub Pages copy: https://asiamotor.pages.dev/api
VITE_API_URL=
